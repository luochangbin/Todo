<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- 图标直接用仓库根目录的 todo.ico；托盘图标复用同一个 exe 图标 -->
    <ApplicationIcon>..\..\todo.ico</ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- 自包含会把整个 .NET 运行时 + WPF 打包进来（约 148MB），压缩后可降到约 66MB。
         代价：首次启动需要把内容解压到临时目录，比未压缩稍慢。 -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- 只保留英文卫星资源，去掉 20 多个语种的 *.resources.dll -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- 托盘图标按系统小图标尺寸从内嵌 ICO 里挑档位，避免把 32px 硬缩到 16px -->
    <EmbeddedResource Include="..\..\todo.ico" LogicalName="TodoWidget.todo.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- 只为了托盘图标引入 WinForms；移除它带来的隐式 using，避免与 WPF 的
         Application / Color / Button 等同名类型冲突 -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TodoWidget.Core\TodoWidget.Core.csproj" />
    <ProjectReference Include="..\TodoWidget.Persistence\TodoWidget.Persistence.csproj" />
  </ItemGroup>

</Project>
