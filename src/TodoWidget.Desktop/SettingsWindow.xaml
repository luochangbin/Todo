<Window x:Class="TodoWidget.Desktop.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        AutomationProperties.AutomationId="SettingsWindow"
        Title="设置"
        Width="360" Height="542"
        SizeToContent="Manual"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Background="Transparent"
        ShowInTaskbar="False"
        FontFamily="Microsoft YaHei UI, Microsoft YaHei, Segoe UI"
        FontSize="13"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
    <Border Background="{DynamicResource Todo.ChromeBrush}"
            BorderBrush="{DynamicResource Todo.SeparatorBrush}"
            BorderThickness="1"
            CornerRadius="0">
        <Grid Margin="16,14,16,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题（可拖动） -->
            <TextBlock x:Name="SettingsTitle" Grid.Row="0"
                       Text="设置" FontSize="16" FontWeight="SemiBold"
                       Margin="0,0,0,14"
                       Foreground="{DynamicResource Todo.FgBrush}"
                       MouseLeftButtonDown="SettingsTitle_MouseLeftButtonDown"/>

            <TextBlock Grid.Row="1" Text="背景颜色"
                       Foreground="{DynamicResource Todo.MutedBrush}" FontSize="11.5"/>
            <Grid Grid.Row="2" Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="ColorInput"
                         Height="30"
                         Tag="#RRGGBB 或 none"
                         Text="#1B1C20"
                         AutomationProperties.AutomationId="ColorInput"/>
                <WrapPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                    <Button x:Name="ColorPresetNone" Margin="2,0" Tag="none"
                            Style="{StaticResource Todo.Swatch}"
                            Click="ColorPreset_Click" AutomationProperties.AutomationId="ColorPresetNone"
                            AutomationProperties.Name="无背景" ToolTip="无背景（面板不填充也不描边）">
                        <Path Data="M 1,17 L 17,1"
                              Width="18" Height="18"
                              Stretch="None"
                              Stroke="{DynamicResource Todo.MutedBrush}"
                              StrokeThickness="1.4"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"/>
                    </Button>
                    <Button x:Name="ColorPreset1" Margin="2,0" Tag="#1B1C20"
                            Style="{StaticResource Todo.Swatch}"
                            Click="ColorPreset_Click" AutomationProperties.AutomationId="ColorPreset1"
                            AutomationProperties.Name="深灰" ToolTip="#1B1C20"/>
                    <Button x:Name="ColorPreset2" Margin="2,0" Tag="#2F3E46"
                            Style="{StaticResource Todo.Swatch}"
                            Click="ColorPreset_Click" AutomationProperties.AutomationId="ColorPreset2"
                            AutomationProperties.Name="墨绿" ToolTip="#2F3E46"/>
                    <Button x:Name="ColorPreset3" Margin="2,0" Tag="#1F3A4D"
                            Style="{StaticResource Todo.Swatch}"
                            Click="ColorPreset_Click" AutomationProperties.AutomationId="ColorPreset3"
                            AutomationProperties.Name="藏蓝" ToolTip="#1F3A4D"/>
                    <Button x:Name="ColorPreset4" Margin="2,0" Tag="#E9E4D8"
                            Style="{StaticResource Todo.Swatch}"
                            Click="ColorPreset_Click" AutomationProperties.AutomationId="ColorPreset4"
                            AutomationProperties.Name="米白" ToolTip="#E9E4D8"/>
                    <Button x:Name="ColorPreset5" Margin="2,0" Tag="#404258"
                            Style="{StaticResource Todo.Swatch}"
                            Click="ColorPreset_Click" AutomationProperties.AutomationId="ColorPreset5"
                            AutomationProperties.Name="石板" ToolTip="#404258"/>
                </WrapPanel>
            </Grid>

            <TextBlock Grid.Row="3" Text="待办文字颜色"
                       Margin="0,14,0,0"
                       Foreground="{DynamicResource Todo.MutedBrush}" FontSize="11.5"/>
            <Grid Grid.Row="4" Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TextColorInput"
                         Height="30"
                         Tag="#RRGGBB"
                         Text="#E9EAEE"
                         AutomationProperties.AutomationId="TextColorInput"/>
                <WrapPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                    <Button x:Name="TextPreset1" Margin="2,0" Tag="#E9EAEE"
                            Style="{StaticResource Todo.Swatch}"
                            Click="TextPreset_Click" AutomationProperties.AutomationId="TextPreset1"
                            AutomationProperties.Name="近白" ToolTip="#E9EAEE"/>
                    <Button x:Name="TextPreset2" Margin="2,0" Tag="#7FB2FF"
                            Style="{StaticResource Todo.Swatch}"
                            Click="TextPreset_Click" AutomationProperties.AutomationId="TextPreset2"
                            AutomationProperties.Name="天蓝" ToolTip="#7FB2FF"/>
                    <Button x:Name="TextPreset3" Margin="2,0" Tag="#7ED9A6"
                            Style="{StaticResource Todo.Swatch}"
                            Click="TextPreset_Click" AutomationProperties.AutomationId="TextPreset3"
                            AutomationProperties.Name="薄荷绿" ToolTip="#7ED9A6"/>
                    <Button x:Name="TextPreset4" Margin="2,0" Tag="#FFB86B"
                            Style="{StaticResource Todo.Swatch}"
                            Click="TextPreset_Click" AutomationProperties.AutomationId="TextPreset4"
                            AutomationProperties.Name="暖橙" ToolTip="#FFB86B"/>
                    <Button x:Name="TextPreset5" Margin="2,0" Tag="#D9A6FF"
                            Style="{StaticResource Todo.Swatch}"
                            Click="TextPreset_Click" AutomationProperties.AutomationId="TextPreset5"
                            AutomationProperties.Name="淡紫" ToolTip="#D9A6FF"/>
                    <Button x:Name="TextPreset6" Margin="2,0" Tag="#2B2F36"
                            Style="{StaticResource Todo.Swatch}"
                            Click="TextPreset_Click" AutomationProperties.AutomationId="TextPreset6"
                            AutomationProperties.Name="深灰（浅色背景用）" ToolTip="#2B2F36"/>
                </WrapPanel>
            </Grid>


            <Grid Grid.Row="5" Margin="0,14,0,0">
                <TextBlock Text="不透明度（拖动即时预览，保存后生效）"
                           Foreground="{DynamicResource Todo.MutedBrush}" FontSize="11.5"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="OpacityValue"
                           HorizontalAlignment="Right" VerticalAlignment="Center"
                           FontSize="11.5"
                           Foreground="{DynamicResource Todo.FgBrush}"
                           AutomationProperties.AutomationId="OpacityValue"/>
            </Grid>
            <Slider x:Name="OpacitySlider" Grid.Row="6" Margin="0,6,0,0"
                    Style="{StaticResource Todo.Slider}"
                    Minimum="35" Maximum="100" Value="100"
                    ValueChanged="OpacitySlider_ValueChanged"
                    AutomationProperties.AutomationId="OpacitySlider"
                    AutomationProperties.Name="不透明度"/>

            <TextBlock Grid.Row="7" Text="已完成事项显示范围"
                       Margin="0,16,0,0"
                       Foreground="{DynamicResource Todo.MutedBrush}" FontSize="11.5"/>
            <StackPanel Grid.Row="8" Orientation="Horizontal" Margin="0,7,0,0">
                <RadioButton x:Name="RangeWeek" Content="最近一周" GroupName="CompletedRange"
                             AutomationProperties.AutomationId="RangeWeek"/>
                <RadioButton x:Name="RangeMonth" Content="最近一个月" GroupName="CompletedRange"
                             Margin="20,0,0,0"
                             AutomationProperties.AutomationId="RangeMonth"/>
                <RadioButton x:Name="RangeAll" Content="全部" GroupName="CompletedRange"
                             Margin="20,0,0,0"
                             AutomationProperties.AutomationId="RangeAll"/>
            </StackPanel>

            <TextBlock Grid.Row="9" Text="全局快捷键（同一个键：隐藏时唤出，显示时隐藏；留空禁用）"
                       Margin="0,14,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource Todo.MutedBrush}" FontSize="11.5"/>
            <TextBox x:Name="ToggleHotkeyInput" Grid.Row="10" Height="30" Margin="0,4,0,0"
                     Tag="如 Alt+Q"
                     AutomationProperties.AutomationId="ToggleHotkeyInput"/>

            <TextBlock x:Name="ErrorLabel" Grid.Row="11"
                       Margin="0,10,0,0" TextWrapping="Wrap" FontSize="12"
                       Foreground="{DynamicResource Todo.ErrorFgBrush}"
                       Visibility="Collapsed"
                       AutomationProperties.AutomationId="SettingsError"/>

            <StackPanel Grid.Row="13" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Content="取消" Width="72" Height="30"
                        Style="{StaticResource Todo.SecondaryButton}"
                        Click="CancelButton_Click" AutomationProperties.AutomationId="SettingsCancel"/>
                <Button x:Name="SaveButton" Content="保存" Width="72" Height="30" Margin="8,0,0,0"
                        Style="{StaticResource Todo.PrimaryButton}"
                        Click="SaveButton_Click" AutomationProperties.AutomationId="SettingsSave"/>
            </StackPanel>

        </Grid>
    </Border>
</Window>