<Window x:Class="TodoWidget.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        AutomationProperties.AutomationId="MainWindow"
        Title="Todo"
        Width="330" Height="420"
        MinWidth="220" MinHeight="160"
        SizeToContent="Manual"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Background="Transparent"
        ShowInTaskbar="False"
        FontFamily="Microsoft YaHei UI, Microsoft YaHei, Segoe UI"
        FontSize="13"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        PreviewKeyDown="MainWindow_PreviewKeyDown"
        PreviewMouseLeftButtonDown="MainWindow_PreviewMouseLeftButtonDown"
        PreviewMouseMove="MainWindow_PreviewMouseMove"
        PreviewMouseLeftButtonUp="MainWindow_PreviewMouseLeftButtonUp">
    <Border x:Name="Chrome"
            Background="{DynamicResource Todo.SurfaceBrush}"
            BorderBrush="{DynamicResource Todo.PanelBorderBrush}"
            BorderThickness="1"
            CornerRadius="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="1"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 标题栏：窗口拖动 -->
            <Grid x:Name="HeaderBar" Grid.Row="0" Background="Transparent"
                  MouseLeftButtonDown="HeaderBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TitleText"
                           Margin="13,0,0,0"
                           Text="Todo"
                           FontSize="14"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Todo.SurfaceFgBrush}"/>
                <TextBlock x:Name="CounterText"
                           Grid.Column="1"
                           Margin="10,0,6,0"
                           FontSize="11"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Todo.SurfaceMutedBrush}"
                           AutomationProperties.AutomationId="CounterText"/>
                <Button x:Name="AddButton"
                        Grid.Column="2"
                        Margin="0,0,2,0"
                        Style="{StaticResource Todo.IconButton}"
                        Click="AddButton_Click"
                        AutomationProperties.AutomationId="AddButton"
                        AutomationProperties.Name="新增事项"
                        ToolTip="新增事项">
                    <Path Data="M 8,3 V 13 M 3,8 H 13"
                          Width="16" Height="16"
                          Stretch="None"
                          Stroke="{DynamicResource Todo.SurfaceMutedBrush}"
                          StrokeThickness="1.6"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"/>
                </Button>
                <ToggleButton x:Name="PinButton"
                              Grid.Column="3"
                              Margin="0,0,2,0"
                              Style="{StaticResource Todo.IconToggle}"
                              Click="PinButton_Click"
                              AutomationProperties.AutomationId="PinButton"
                              AutomationProperties.Name="窗口置顶">
                    <Path Data="{StaticResource Todo.PinIcon}"
                          Style="{StaticResource Todo.ToggleGlyph}"/>
                </ToggleButton>
                <Button x:Name="SettingsButton"
                        Grid.Column="4"
                        Margin="0,0,7,0"
                        Style="{StaticResource Todo.IconButton}"
                        Click="SettingsButton_Click"
                        AutomationProperties.AutomationId="SettingsButton"
                        AutomationProperties.Name="设置"
                        ToolTip="外观和快捷键设置">
                    <Path Data="M 1.5,5 H 7.6 M 11.6,5 H 14.5 M 1.5,11 H 4.4 M 8.4,11 H 14.5 M 7.6,5 a 2,2 0 1,0 4,0 a 2,2 0 1,0 -4,0 M 4.4,11 a 2,2 0 1,0 4,0 a 2,2 0 1,0 -4,0"
                          Width="16" Height="16"
                          Stretch="None"
                          Stroke="{DynamicResource Todo.SurfaceMutedBrush}"
                          StrokeThickness="1.3"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"/>
                </Button>
            </Grid>

            <!-- 标题栏分隔线 -->
            <Border Grid.Row="1" Height="1" Margin="12,0,12,0"
                    Background="{DynamicResource Todo.SeparatorBrush}"/>

            <!-- 错误提示条 -->
            <Border x:Name="ErrorBar" Grid.Row="2"
                    Margin="9,6,9,0"
                    Background="{DynamicResource Todo.ErrorBrush}"
                    CornerRadius="0"
                    Visibility="Collapsed"
                    AutomationProperties.AutomationId="ErrorBar">
                <DockPanel Margin="9,5">
                    <Button x:Name="ErrorCloseButton"
                            DockPanel.Dock="Right"
                            Style="{StaticResource Todo.IconButton}"
                            Width="20" Height="20"
                            Click="ErrorCloseButton_Click"
                            AutomationProperties.AutomationId="ErrorCloseButton"
                            AutomationProperties.Name="关闭错误提示">
                        <Path Data="M 3,3 L 11,11 M 11,3 L 3,11"
                              Width="14" Height="14"
                              Stretch="None"
                              Stroke="{DynamicResource Todo.ErrorFgBrush}"
                              StrokeThickness="1.5"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"/>
                    </Button>
                    <TextBlock x:Name="ErrorText"
                               TextWrapping="Wrap"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource Todo.ErrorFgBrush}"
                               AutomationProperties.AutomationId="ErrorText"/>
                </DockPanel>
            </Border>

            <!-- 事项列表 -->
            <ScrollViewer x:Name="ListScroll" Grid.Row="3" Margin="0,6,0,8"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="RowsPanel" Background="Transparent"/>
            </ScrollViewer>

            <!-- 删除确认气泡（Popconfirm）：锚定到被点击的删除图标 -->
            <Popup x:Name="DeleteConfirm"
                   Placement="Left"
                   HorizontalOffset="-6"
                   StaysOpen="False"
                   AllowsTransparency="True"
                   PopupAnimation="Fade"
                   AutomationProperties.AutomationId="DeleteConfirm"
                   Closed="DeleteConfirm_Closed">
                <Border Background="{DynamicResource Todo.ChromeBrush}"
                        BorderBrush="{DynamicResource Todo.SeparatorBrush}"
                        BorderThickness="1"
                        CornerRadius="0"
                        Padding="12,10">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.5" Color="#000000"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="删除这条事项？"
                                   FontSize="12.5"
                                   Foreground="{DynamicResource Todo.FgBrush}"/>
                        <TextBlock x:Name="DeleteConfirmText"
                                   FontSize="11.5"
                                   MaxWidth="200"
                                   Margin="0,3,0,0"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource Todo.MutedBrush}"
                                   AutomationProperties.AutomationId="DeleteConfirmText"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                            <Button x:Name="DeleteCancelButton"
                                    Content="取消"
                                    Width="56" Height="26"
                                    Style="{StaticResource Todo.SecondaryButton}"
                                    Click="DeleteCancelButton_Click"
                                    AutomationProperties.AutomationId="DeleteCancel"/>
                            <Button x:Name="DeleteConfirmButton"
                                    Content="删除"
                                    Width="56" Height="26"
                                    Margin="8,0,0,0"
                                    Style="{StaticResource Todo.DangerButton}"
                                    Click="DeleteConfirmButton_Click"
                                    AutomationProperties.AutomationId="DeleteConfirmOk"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>
    </Border>
</Window>
