<Application x:Class="TodoWidget.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnLastWindowClose">
    <Application.Resources>
        <!--
            设计 token（默认值对应暗色主题的 #1B1C20 底色）。
            运行时由 MainWindow.ApplyVisuals() 依据用户背景色重新写入：
            Chrome 为用户选色，Hover/Input/Separator 由背景色派生，其余固定。
        -->
        <SolidColorBrush x:Key="Todo.ChromeBrush" Color="#1B1C20"/>
        <!-- 主窗口面板底色：= ChromeBrush + 用户设置的不透明度 alpha，运行时写入 -->
        <SolidColorBrush x:Key="Todo.SurfaceBrush" Color="#1B1C20"/>
        <!-- 主窗口面板边框：选「无背景」时为全透明 -->
        <SolidColorBrush x:Key="Todo.PanelBorderBrush" Color="#24262C"/>
        <!-- 主窗口面板上的前景内容：文字/图标/强调元素，alpha 跟随面板但保留可读下限；
             非 Surface 的同类 token 保持不透明，供设置窗口与确认气泡使用 -->
        <SolidColorBrush x:Key="Todo.SurfaceFgBrush" Color="#E9EAEE"/>
        <SolidColorBrush x:Key="Todo.SurfaceMutedBrush" Color="#8C919B"/>
        <SolidColorBrush x:Key="Todo.SurfaceAccentBrush" Color="#5B7CFA"/>
        <!-- 待办文本专用前景：只作用于首页事项文本 -->
        <SolidColorBrush x:Key="Todo.TextFgBrush" Color="#E9EAEE"/>
        <SolidColorBrush x:Key="Todo.TextMutedBrush" Color="#8C919B"/>
        <SolidColorBrush x:Key="Todo.FgBrush" Color="#E9EAEE"/>
        <SolidColorBrush x:Key="Todo.MutedBrush" Color="#8C919B"/>
        <SolidColorBrush x:Key="Todo.SeparatorBrush" Color="#24262C"/>
        <SolidColorBrush x:Key="Todo.HoverBrush" Color="#26282E"/>
        <SolidColorBrush x:Key="Todo.InputBrush" Color="#141518"/>
        <SolidColorBrush x:Key="Todo.AccentBrush" Color="#5B7CFA"/>
        <SolidColorBrush x:Key="Todo.AccentHoverBrush" Color="#6E8BFF"/>
        <SolidColorBrush x:Key="Todo.AccentFgBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Todo.ErrorBrush" Color="#7A3030"/>
        <SolidColorBrush x:Key="Todo.ErrorFgBrush" Color="#FFD9D9"/>
        <!-- 破坏性操作：两套主题共用，白字对比度 ≥4.5:1 -->
        <SolidColorBrush x:Key="Todo.DangerBrush" Color="#D03A3F"/>
        <SolidColorBrush x:Key="Todo.DangerHoverBrush" Color="#B8323A"/>
        <SolidColorBrush x:Key="Todo.DangerFgBrush" Color="#FFFFFF"/>

        <!-- 行内操作图标几何（16x16 坐标系，Stretch=None 直接使用） -->
        <PathGeometry x:Key="Todo.EditIcon"
                      Figures="M 2.5,13.5 L 3.1,11.1 L 11.3,2.9 L 13.1,4.7 L 4.9,12.9 Z M 9.8,4.4 L 11.6,6.2"/>
        <PathGeometry x:Key="Todo.DeleteIcon"
                      Figures="M 3,4.6 H 13 M 6.4,4.6 V 2.8 H 9.6 V 4.6 M 4.6,4.6 L 5.4,13.2 H 10.6 L 11.4,4.6 M 7,7.2 V 11 M 9,7.2 V 11"/>
        <!-- 图钉（窗口置顶开关），未激活为弱化灰、激活为强调色 -->
        <PathGeometry x:Key="Todo.PinIcon"
                      Figures="M 5.5,2.5 H 10.5 V 4.3 L 12.2,6.6 H 3.8 L 5.5,4.3 Z M 8,6.6 V 13.3"/>

        <!-- 键盘 focus 环：只在使用键盘导航时出现 -->
        <Style x:Key="Todo.FocusVisual">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border BorderBrush="{DynamicResource Todo.AccentBrush}"
                                BorderThickness="1.5"
                                CornerRadius="4"
                                Margin="-1"
                                Opacity="0.75"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 事项行：hover 用底色区分，不产生任何位移 -->
        <Style x:Key="Todo.Row" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Todo.HoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="{x:Type CheckBox}">
            <Setter Property="Foreground" Value="{DynamicResource Todo.FgBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource Todo.FocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid Width="16" Height="16" Grid.Column="0">
                                <Border x:Name="Box"
                                        Background="Transparent"
                                        BorderBrush="{DynamicResource Todo.SurfaceMutedBrush}"
                                        BorderThickness="1"
                                        CornerRadius="0"
                                        SnapsToDevicePixels="True"/>
                                <Path x:Name="Glyph"
                                      Data="M 3.5,8.3 L 6.7,11.5 L 12.6,4.6"
                                      Stroke="{DynamicResource Todo.AccentFgBrush}"
                                      StrokeThickness="1.9"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Visibility="Collapsed"/>
                            </Grid>
                            <ContentPresenter x:Name="ContentPresenter"
                                              Grid.Column="1"
                                              Margin="8,0,0,0"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              RecognizesAccessKey="False"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Content" Value="{x:Null}">
                                <Setter TargetName="ContentPresenter" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource Todo.SurfaceAccentBrush}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Todo.SurfaceAccentBrush}"/>
                                <Setter TargetName="Glyph" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Todo.SurfaceAccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type RadioButton}">
            <Setter Property="Foreground" Value="{DynamicResource Todo.FgBrush}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource Todo.FocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid Width="16" Height="16" Grid.Column="0" VerticalAlignment="Center">
                                <Ellipse x:Name="Ring"
                                         Fill="Transparent"
                                         Stroke="{DynamicResource Todo.MutedBrush}"
                                         StrokeThickness="1"
                                         SnapsToDevicePixels="True"/>
                                <Ellipse x:Name="Dot"
                                         Width="8" Height="8"
                                         Fill="{DynamicResource Todo.AccentBrush}"
                                         Visibility="Collapsed"/>
                            </Grid>
                            <ContentPresenter Grid.Column="1"
                                              Margin="7,0,0,0"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding Content}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              RecognizesAccessKey="False"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Todo.AccentBrush}"/>
                                <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Todo.AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Background" Value="{DynamicResource Todo.InputBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource Todo.FgBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Todo.FgBrush}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource Todo.AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Todo.SeparatorBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource Todo.FocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="0"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <!-- 占位提示：Text 为空且未聚焦时显示，Tag 提供文案 -->
                                <TextBlock x:Name="Placeholder"
                                           Text="{TemplateBinding Tag}"
                                           Margin="{TemplateBinding Padding}"
                                           Foreground="{DynamicResource Todo.MutedBrush}"
                                           FontSize="{TemplateBinding FontSize}"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           Visibility="Collapsed"/>
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Todo.AccentBrush}"/>
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 行内编辑/新增（事项行与草稿行共用）：文字起点与事项行一致——透明底、无边框、无内边距，
             只用行背景 + 一条 1px 强调色细线表示"正在输入"，避免切换编辑态时文字跳动。
             纯空框不可见，因此保留占位提示（Tag 提供）。 -->
        <Style x:Key="Todo.RowEditor" TargetType="{x:Type TextBox}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Todo.TextFgBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Todo.TextFgBrush}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource Todo.AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Todo.AccentBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource Todo.FocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border x:Name="bd"
                                Background="Transparent"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <TextBlock x:Name="Placeholder"
                                           Text="{TemplateBinding Tag}"
                                           Margin="2,0,0,0"
                                           Foreground="{DynamicResource Todo.MutedBrush}"
                                           FontSize="{TemplateBinding FontSize}"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           Visibility="Collapsed"/>
                                <ScrollViewer x:Name="PART_ContentHost"
                                              VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type Button}">
            <Setter Property="Foreground" Value="{DynamicResource Todo.FgBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource Todo.FocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="False"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Todo.HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 主操作按钮（添加 / 保存） -->
        <Style x:Key="Todo.PrimaryButton" TargetType="{x:Type Button}"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="{DynamicResource Todo.AccentFgBrush}"/>
            <Setter Property="Background" Value="{DynamicResource Todo.AccentBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="False"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Todo.AccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 次级按钮（取消等）：需要有可见的边框与底色，避免只剩文字 -->
        <Style x:Key="Todo.SecondaryButton" TargetType="{x:Type Button}"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="{DynamicResource Todo.FgBrush}"/>
            <Setter Property="Background" Value="{DynamicResource Todo.InputBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Todo.SeparatorBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="False"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Todo.HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 纯图标按钮（设置、关闭） -->
        <Style x:Key="Todo.IconButton" TargetType="{x:Type Button}"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <!-- 设置窗口的颜色预设色块 -->
        <Style x:Key="Todo.Swatch" TargetType="{x:Type Button}"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Todo.SeparatorBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 破坏性主按钮（删除确认） -->
        <Style x:Key="Todo.DangerButton" TargetType="{x:Type Button}"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="{DynamicResource Todo.DangerFgBrush}"/>
            <Setter Property="Background" Value="{DynamicResource Todo.DangerBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="False"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Todo.DangerHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 事项行悬停时浮出的操作区：Hidden 而非 Collapsed，避免文本宽度随悬停变化 -->
        <Style x:Key="Todo.RowActions" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{DynamicResource Todo.HoverBrush}"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Padding" Value="2,0"/>
            <Setter Property="Visibility" Value="Hidden"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type Border}}}"
                             Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 行内图标按钮（编辑 / 删除） -->
        <Style x:Key="Todo.RowIcon" TargetType="{x:Type Button}"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource Todo.SurfaceMutedBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="4" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Todo.SurfaceFgBrush}"/>
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Todo.SeparatorBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 标题栏图标开关（窗口置顶图钉）：选中态用强调色 -->
        <Style x:Key="Todo.IconToggle" TargetType="{x:Type ToggleButton}">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource Todo.FocusVisual}"/>
            <Setter Property="Foreground" Value="{DynamicResource Todo.SurfaceMutedBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="4" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Todo.SurfaceFgBrush}"/>
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Todo.HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Todo.SurfaceAccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Todo.ToggleGlyph" TargetType="{x:Type Path}">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Stretch" Value="None"/>
            <Setter Property="StrokeThickness" Value="1.3"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="Stroke"
                    Value="{Binding Foreground, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ToggleButton}}}"/>
        </Style>

        <!-- 行内图标：描边跟随按钮 Foreground，悬停时自然变亮 -->
        <Style x:Key="Todo.RowIconGlyph" TargetType="{x:Type Path}">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Stretch" Value="None"/>
            <Setter Property="StrokeThickness" Value="1.4"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="Stroke"
                    Value="{Binding Foreground, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Button}}}"/>
        </Style>

        <!-- 置顶项的常驻标记：强调色小图钉，不参与命中测试（操作仍走悬停浮出的按钮） -->
        <Style x:Key="Todo.PinMark" TargetType="{x:Type Path}">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Stretch" Value="None"/>
            <Setter Property="StrokeThickness" Value="1.3"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="Stroke" Value="{DynamicResource Todo.SurfaceAccentBrush}"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>

        <!-- 极简滑块（不透明度）：4px 轨道 + 强调色已填充段 + 14px 圆滑块 -->
        <Style x:Key="Todo.Slider" TargetType="{x:Type Slider}">
            <Setter Property="Height" Value="20"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource Todo.FocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Slider}">
                        <Grid Background="Transparent">
                            <Border Height="4"
                                    CornerRadius="0"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource Todo.SeparatorBrush}"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="{x:Type RepeatButton}">
                                                <Border Height="4"
                                                        CornerRadius="0"
                                                        VerticalAlignment="Center"
                                                        Background="{DynamicResource Todo.AccentBrush}"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False" Opacity="0"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="14" Height="14">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Ellipse Fill="{DynamicResource Todo.AccentBrush}"
                                                         Stroke="{DynamicResource Todo.ChromeBrush}"
                                                         StrokeThickness="2"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ToolTip}">
            <!-- 提示气泡用不透明底色，保证任何面板不透明度下都清晰 -->
            <Setter Property="Background" Value="{DynamicResource Todo.ChromeBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource Todo.FgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Todo.SeparatorBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HasDropShadow" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToolTip}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 细滚动条：仅纵向使用 -->
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True" Focusable="False">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb MinHeight="24">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border Background="{DynamicResource Todo.SeparatorBrush}"
                                                        CornerRadius="0"
                                                        Margin="1"
                                                        SnapsToDevicePixels="True"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="Height" Value="8"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Application.Resources>
</Application>